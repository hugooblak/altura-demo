{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "720px", "wideSize": "1180px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{ "slug": "cream", "name": "Cream", "color": "#EEE9E2" },
				{ "slug": "dark", "name": "Near black", "color": "#151617" },
				{ "slug": "ink", "name": "Ink", "color": "#111111" },
				{ "slug": "bronze", "name": "Bronze (on dark)", "color": "#B29674" },
				{ "slug": "bronze-large", "name": "Bronze (large text on cream)", "color": "#8E7355" },
				{ "slug": "bronze-small", "name": "Bronze (small text on cream)", "color": "#7A6045" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Cormorant, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Cormorant Garamond", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-300-normal.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontStyle": "italic", "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-300-italic.woff2" ] },
						{ "fontFamily": "Cormorant Garamond", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cormorant-garamond-latin-400-normal.woff2" ] }
					]
				},
				{
					"slug": "sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{ "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-latin-300-normal.woff2" ] },
						{ "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-latin-400-normal.woff2" ] },
						{ "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-latin-500-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Body", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.25rem, 1.6vw, 1.5rem)" },
				{ "slug": "x-large", "name": "Heading", "size": "clamp(2.125rem, 3vw, 3.625rem)" },
				{ "slug": "display", "name": "Display", "size": "clamp(2.875rem, 5vw, 5.5rem)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.5rem, 2.4vw, 2.5rem)" },
				{ "slug": "60", "name": "L", "size": "clamp(3rem, 6vw, 6rem)" }
			]
		},
		"border": { "radius": false }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--dark)", "text": "var(--wp--preset--color--ink)" },
		"spacing": { "blockGap": "0" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6",
			"fontWeight": "300"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "300", "lineHeight": "1.1" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "400" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" }
			},
			"button": {
				"color": { "background": "transparent", "text": "var(--wp--preset--color--bronze)" },
				"border": { "width": "1px", "style": "solid", "color": "var(--wp--preset--color--bronze)", "radius": "0" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "2.4rem", "right": "2.4rem" } },
				"typography": { "fontSize": "0.75rem", "fontWeight": "500", "letterSpacing": "0.26em", "textTransform": "uppercase", "lineHeight": "1.2", "textDecoration": "none" },
				":hover": { "color": { "background": "var(--wp--preset--color--bronze)", "text": "var(--wp--preset--color--dark)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--bronze)", "text": "var(--wp--preset--color--dark)" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": { "link": { "color": { "text": "currentColor" }, "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.71875rem", "fontWeight": "400", "letterSpacing": "0.22em", "textTransform": "uppercase" },
				"elements": { "link": { "color": { "text": "currentColor" }, "typography": { "textDecoration": "none" } } }
			},
			"core/separator": { "color": { "text": "currentColor" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
